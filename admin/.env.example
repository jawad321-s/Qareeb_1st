# Qareeb — Admin environment.
# Optional: without `.env.local` the dashboard uses the team's Firebase project
# (qareeb-b9a54), built into lib/config.ts — the same one as the mobile app.
# Copy to `.env.local` only to point at another project or force mock data.

# Firebase web config (Project settings → General → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side admin SDK key (JSON string) — used by scripts/route handlers
FIREBASE_SERVICE_ACCOUNT=

# Force mock even when Firebase is configured: set to true
# NEXT_PUBLIC_USE_MOCK=true

# Use the local Firebase emulators (firebase emulators:start) instead of the
# real project — the host they run on, e.g. 127.0.0.1
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
