# Qareeb — Admin environment.
# Copy to `.env.local` and fill in the SAME Firebase project as the mobile app
# to share data live. Leave blank to run on local mock data.

# Firebase web config (Project settings → General → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side admin SDK key (JSON string) — used by scripts/route handlers
FIREBASE_SERVICE_ACCOUNT=

# Force mock even when Firebase is configured: set to true
# NEXT_PUBLIC_USE_MOCK=true
