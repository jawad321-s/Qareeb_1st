@startuml
!include _style.iuml
left to right direction
actor Customer as C
rectangle "Qareeb System" {
  usecase "UC-01 Register and verify\nthe phone number by SMS" as U01
  usecase "UC-02 Sign in" as U02
  usecase "UC-03 Reset the password by SMS" as U03
  usecase "UC-04 Manage profile and settings" as U04
  usecase "UC-05 Post a service request" as U05
  usecase "Set the request location" as U05a
  usecase "Attach photos\n(camera or gallery)" as U05b
  usecase "UC-06 Compare offers\nand accept one" as U06
  usecase "UC-07 Decline an offer\nwith a reason" as U07
  usecase "UC-08 Track the request status" as U08
  usecase "UC-09 Cancel or repost a request" as U09
  usecase "UC-10 Chat with the other party" as U10
  usecase "UC-11 Rate the other party" as U11
  usecase "UC-12 Report a complaint" as U12
  usecase "UC-13 Suggest a service" as U13
  usecase "UC-14 Chat with Qareeb support" as U14
}
C -- U01
C -- U02
C -- U03
C -- U04
C -- U05
C -- U06
C -- U07
C -- U08
C -- U09
C -- U10
C -- U11
C -- U12
C -- U13
C -- U14
