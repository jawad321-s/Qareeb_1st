  users {
    string uid PK
    string role
    string fullName
    string phone
    map location
    string status
    boolean verified
  }
  notifications {
    string id PK
    string type
    boolean read
  }
  categories {
    string id PK
    map name
    boolean active
  }
  services {
    string id PK
    string categoryId FK
    map name
  }
