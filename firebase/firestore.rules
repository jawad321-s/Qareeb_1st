rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Qareeb — Cloud Firestore Security Rules
// Model: customers own their requests; artisans read pending requests & manage
// their own offers; admins (custom claim) have full read + moderated writes.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // A suspended account (claim set by the dashboard) is signed in only for
    // its own profile and the support chat; every other rule refuses it.
    function isSignedIn() {
      return request.auth != null && request.auth.token.get('suspended', false) != true;
    }
    function isAuthed() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }
    // Customer/artisan roles live on users/{uid}.role, written once at sign-up
    // and locked by the users update rule below, so no Cloud Function is needed
    // to issue claims. Admins still use the `role` custom claim (set-role script).
    function userDoc() {
      return /databases/$(database)/documents/users/$(uid());
    }
    function isArtisan() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'artisan'
        || (exists(userDoc()) && get(userDoc()).data.role == 'artisan'));
    }
    function existing() {
      return resource.data;
    }
    function incoming() {
      return request.resource.data;
    }
    // Field-level guards used on writes.
    function isValidString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // ── users/{uid} ──────────────────────────────────────────────────────────
    match /users/{userId} {
      // A user reads their own doc; admins read all. Artisans are public
      // service providers, so any signed-in user can read an artisan's doc
      // (listings, profiles, chat headers). A customer's doc holds their phone
      // number and home location, so only they and the admins read it; what
      // others see of a customer comes from publicProfiles/{uid}.
      allow read: if (isAuthed() && uid() == userId)
                  || (isSignedIn() && (isAdmin() || resource.data.role == 'artisan'));
      allow create: if isSignedIn() && uid() == userId
                    && incoming().role in ['customer', 'artisan'];
      allow update: if isSignedIn() && (
                      (uid() == userId
                        // A user can never escalate their own role/verified/status.
                        && incoming().role == existing().role
                        && incoming().status == existing().status
                        && incoming().verified == existing().verified)
                      || isAdmin());
      allow delete: if isAdmin();

      // Their own notifications and push tokens stay theirs while suspended,
      // so the team's replies in the support chat still reach the phone.
      match /notifications/{notifId} {
        allow read, update: if isAuthed() && uid() == userId;
        allow create: if isAdmin(); // written by Cloud Functions (admin SDK)
        allow delete: if isAuthed() && uid() == userId;
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isAuthed() && uid() == userId;
      }
      // Chats the user deleted for themselves (requestId → hiddenAt): the
      // other side keeps theirs, and only the owner sees this list.
      match /hiddenChats/{requestId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
    }

    // ── artisanProfiles/{uid} ────────────────────────────────────────────────
    match /artisanProfiles/{artisanId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
                              (uid() == artisanId
                                // verificationStatus & premium are admin-controlled.
                                && incoming().verificationStatus == (resource == null ? 'unsubmitted' : existing().verificationStatus)
                                && incoming().premium == (resource == null ? false : existing().premium)
                                // The job count and the featured badge are counted by Cloud Functions.
                                && incoming().get('completedJobs', 0) == (resource == null ? 0 : existing().get('completedJobs', 0))
                                && incoming().get('featured', false) == (resource == null ? false : existing().get('featured', false)))
                              || isAdmin());
      allow delete: if isAdmin();
    }

    // ── publicProfiles/{uid} ─────────────────────────────────────────────────
    // What other users may see of an account: name, photo, rating and join
    // date, never contact details. Each user's own app keeps theirs current.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
                              (uid() == userId
                                && incoming().keys().hasOnly(['uid', 'role', 'fullName', 'photoUrl', 'rating', 'ratingCount', 'createdAt', 'updatedAt'])
                                && incoming().uid == userId
                                && incoming().role == get(userDoc()).data.role)
                              || isAdmin());
      allow delete: if isAdmin();
    }

    // ── settings/{id} ────────────────────────────────────────────────────────
    // Platform settings the admin edits, e.g. the support contacts in Help.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── categories / services (read-only to clients) ─────────────────────────
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── requests/{id} ────────────────────────────────────────────────────────
    match /requests/{requestId} {
      // Owner and admins always read. An artisan reads a request only once it
      // was sent to them (Cloud Functions list them in notifiedArtisanIds) or
      // they were hired for it: not every open request in the area, with the
      // customer's location.
      allow read: if isSignedIn() && (
                    existing().customerId == uid()
                    || isAdmin()
                    || (isArtisan() && (uid() in existing().notifiedArtisanIds
                          || existing().acceptedArtisanId == uid())));
      // Only the steps of a request's life, by the person each belongs to.
      // Everything else (dispatch, expiry with the functions running) is done
      // by Cloud Functions, which the rules don't apply to.
      function changed() {
        return incoming().diff(existing()).affectedKeys();
      }
      function byCustomer() {
        return existing().customerId == uid();
      }
      function byHired() {
        return existing().get('acceptedArtisanId', '') == uid();
      }
      // The customer takes one of the offers on it, while it still waits for
      // offers: not after it was cancelled or expired.
      function acceptsOffer() {
        let offer = get(/databases/$(database)/documents/offers/$(incoming().acceptedOfferId)).data;
        return byCustomer()
          && existing().status == 'PENDING' && incoming().status == 'ACCEPTED'
          && changed().hasOnly(['status', 'acceptedOfferId', 'acceptedArtisanId', 'updatedAt'])
          && offer.requestId == requestId
          && offer.artisanId == incoming().acceptedArtisanId
          && offer.status == 'PENDING';
      }
      // Called off before the work starts: by the customer, or by the hired
      // artisan once hired; who did it is recorded.
      function cancels() {
        return (byCustomer() || (byHired() && existing().status != 'PENDING'))
          && existing().status in ['PENDING', 'ACCEPTED', 'ON_THE_WAY']
          && incoming().status == 'CANCELLED'
          && incoming().cancelledBy == uid()
          && changed().hasOnly(['status', 'cancelledBy', 'cancelChoice', 'cancelNote', 'updatedAt']);
      }
      // The hired artisan moves the job on, one step at a time.
      function advances() {
        return byHired()
          && changed().hasOnly(['status', 'updatedAt', 'completedAt'])
          && ((existing().status == 'ACCEPTED' && incoming().status == 'ON_THE_WAY')
            || (existing().status == 'ON_THE_WAY' && incoming().status == 'WORKING')
            || (existing().status == 'WORKING' && incoming().status == 'COMPLETED'));
      }
      // A job nobody finished is completed 48 hours after its last change,
      // by whichever side opens the app first.
      function autoCompletes() {
        return (byCustomer() || byHired())
          && existing().status in ['ACCEPTED', 'ON_THE_WAY', 'WORKING']
          && incoming().status == 'COMPLETED' && incoming().autoCompleted == true
          && request.time.toMillis() - existing().updatedAt >= 48 * 3600 * 1000
          && changed().hasOnly(['status', 'completedAt', 'updatedAt', 'autoCompleted']);
      }
      // Without Cloud Functions (no dispatch on it): the customer's app closes
      // a request nobody answered in time.
      function expires() {
        return byCustomer() && existing().status == 'PENDING' && !('dispatch' in existing())
          && incoming().status == 'CANCELLED' && incoming().cancelReason in ['EXPIRED', 'NO_OFFERS']
          && changed().hasOnly(['status', 'cancelReason', 'updatedAt']);
      }
      // An artisan who just quoted bumps the offer count by one.
      function countsOffer() {
        return isArtisan() && existing().status == 'PENDING'
          && changed().hasOnly(['offerCount', 'updatedAt'])
          && incoming().offerCount == existing().offerCount + 1;
      }
      allow create: if isSignedIn()
                    && incoming().customerId == uid()
                    && incoming().status == 'PENDING'
                    && incoming().offerCount == 0
                    && !incoming().keys().hasAny(['dispatch', 'notifiedArtisanIds', 'acceptedArtisanId', 'acceptedOfferId'])
                    && isValidString(incoming().title, 120)
                    && isValidString(incoming().description, 2000);
      allow update: if isAdmin() || (isSignedIn() && (
                      acceptsOffer() || cancels() || advances() || autoCompletes() || expires() || countsOffer()));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // Only the two parties on an accepted request can read/write the thread.
        function req() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        allow read: if isSignedIn() && (req().customerId == uid() || req().acceptedArtisanId == uid() || isAdmin());
        // The thread closes once the job is completed or cancelled. Messages
        // are stored encrypted only (`cipher`, see mobile/src/lib/chatCrypto):
        // a plain text or photo link is refused.
        allow create: if isSignedIn()
                      && incoming().senderId == uid()
                      && (req().customerId == uid() || req().acceptedArtisanId == uid())
                      && req().status in ['ACCEPTED', 'ON_THE_WAY', 'WORKING']
                      && incoming().cipher is string && incoming().cipher.size() <= 20000
                      && !incoming().keys().hasAny(['text', 'mediaUrl']);
        // Only the read mark changes afterwards.
        allow update: if isSignedIn() && (req().customerId == uid() || req().acceptedArtisanId == uid())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      }

      // The conversation's encryption key, readable by its two parties only.
      // Written once (by whoever sends the first message), never changed.
      match /private/{docId} {
        function parties() {
          let r = get(/databases/$(database)/documents/requests/$(requestId)).data;
          return isSignedIn() && (r.customerId == uid() || r.get('acceptedArtisanId', '') == uid());
        }
        allow read: if parties();
        allow create: if parties() && docId == 'chatKey'
                      && incoming().keys().hasOnly(['key', 'createdAt'])
                      && incoming().key is string && incoming().key.size() == 44;
      }
    }

    // ── offers/{id} ──────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if isSignedIn() && (
                    existing().artisanId == uid()
                    || existing().customerId == uid()
                    || isAdmin());
      // Only artisans the request was dispatched to (see Cloud Functions) can
      // quote on it, and only while it is still open. Requests the functions
      // never dispatched (not deployed, e.g. Spark plan) are open to artisans;
      // the app applies the same category/radius policy itself.
      function dispatchedTo(requestId) {
        let req = get(/databases/$(database)/documents/requests/$(requestId)).data;
        return req.status == 'PENDING'
          && (!('dispatch' in req) || uid() in req.get('notifiedArtisanIds', []));
      }
      allow create: if isArtisan()
                    && incoming().artisanId == uid()
                    && incoming().status == 'PENDING'
                    && incoming().price is number && incoming().price > 0
                    && dispatchedTo(incoming().requestId);
      // Artisan may withdraw, or change the price (only the price) of the
      // accepted offer while the work is in progress; customer may accept/reject.
      function priceEditByArtisan() {
        return existing().artisanId == uid()
          && existing().status == 'ACCEPTED'
          && incoming().diff(existing()).affectedKeys().hasOnly(['price', 'priceUpdatedAt'])
          && incoming().price is number && incoming().price > 0
          && get(/databases/$(database)/documents/requests/$(existing().requestId)).data.status == 'WORKING';
      }
      // The customer accepts an offer (only while the request still waits for
      // offers) or turns it down, and records a cancellation on it; the
      // price and the rest stay as the artisan sent them.
      function customerDecides() {
        let accepting = incoming().status == 'ACCEPTED' && existing().status != 'ACCEPTED';
        return existing().customerId == uid()
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedReason', 'rejectChoice', 'rejectNote', 'requestStatus', 'requestCancelChoice', 'requestCancelNote'])
          && incoming().status in [existing().status, 'REJECTED', 'ACCEPTED']
          && (!accepting || (existing().status == 'PENDING'
                && get(/databases/$(database)/documents/requests/$(existing().requestId)).data.status == 'PENDING'));
      }
      allow update: if isSignedIn() && (
                      (existing().artisanId == uid() && existing().status == 'PENDING' && incoming().status == 'WITHDRAWN'
                        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                      || priceEditByArtisan()
                      || customerDecides()
                      || isAdmin());
      allow delete: if isAdmin();
    }

    // ── reviews/{id} ─────────────────────────────────────────────────────────
    match /reviews/{id} {
      allow read: if true;
      // Rating is mandatory for both sides once a job is COMPLETED, and
      // optional after a job that had an artisan was CANCELLED. Only a
      // party to that request may write, only about the other party, and the
      // id is `${requestId}_${authorId}` so each person rates a job once —
      // there is no `update`, so a second write for the same pair is denied.
      allow create: if isSignedIn()
                    && incoming().authorId == uid()
                    && id == incoming().requestId + '_' + uid()
                    && incoming().rating is int
                    && incoming().rating >= 1 && incoming().rating <= 5
                    && reviewableBy(incoming().requestId, incoming().targetId);
      allow update, delete: if isAdmin();
    }
    function reviewableBy(requestId, targetId) {
      let req = get(/databases/$(database)/documents/requests/$(requestId)).data;
      return req.status in ['COMPLETED', 'CANCELLED']
        && ((req.customerId == uid() && req.acceptedArtisanId == targetId)
         || (req.acceptedArtisanId == uid() && req.customerId == targetId));
    }

    // ── subscriptions ────────────────────────────────────────────────────────
    match /subscriptions/{id} {
      allow read: if isSignedIn() && (existing().artisanId == uid() || isAdmin());
      allow create: if isArtisan() && incoming().artisanId == uid();
      // The artisan may cancel their own plan (ends it at once, no refund) —
      // and change nothing else on it.
      allow update: if isAdmin()
                    || (isArtisan() && existing().artisanId == uid()
                        && incoming().status == 'cancelled'
                        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isAdmin();
    }

    // ── complaints ───────────────────────────────────────────────────────────
    // A complaint about a person (an artisan or a customer, usually about a
    // job they had together) or a general problem report. Only the reporter
    // and admins can read it: the person it is about is never told who sent
    // it. Handling it (status, note) is the admin's call.
    match /complaints/{id} {
      allow read: if isSignedIn() && (existing().reporterId == uid() || isAdmin());
      allow create: if isSignedIn()
                    && incoming().reporterId == uid()
                    && incoming().status == 'open'
                    && incoming().reason is string && incoming().reason.size() <= 40
                    && incoming().details is string && incoming().details.size() <= 1000
                    && incoming().get('targetId', null) != uid();
      allow update, delete: if isAdmin();
    }

    // ── broadcasts ───────────────────────────────────────────────────────────
    // System notifications written in the admin dashboard; Cloud Functions
    // deliver each one to its audience and record how many it reached.
    match /broadcasts/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
                    && incoming().status == 'pending'
                    && incoming().audience in ['all', 'customers', 'artisans']
                    && incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 80
                    && incoming().body is string && incoming().body.size() >= 2 && incoming().body.size() <= 500;
    }

    // ── adminLog ─────────────────────────────────────────────────────────────
    // What the admins did to accounts (written by Cloud Functions only).
    match /adminLog/{id} {
      allow read: if isAdmin();
    }

    // ── suggestions ──────────────────────────────────────────────────────────
    // A service a customer or artisan would like the app to offer. Shown in
    // the admin dashboard → Suggestions; only admins review them.
    match /suggestions/{id} {
      allow read: if isSignedIn() && (existing().authorId == uid() || isAdmin());
      allow create: if isSignedIn()
                    && incoming().authorId == uid()
                    && incoming().status == 'new'
                    && incoming().name is string
                    && incoming().name.size() >= 2 && incoming().name.size() <= 60
                    && incoming().details is string && incoming().details.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // ── verificationRequests ─────────────────────────────────────────────────
    match /verificationRequests/{id} {
      // The doc id is the artisan's uid, so this also lets an artisan check
      // for (or listen to) a request that doesn't exist yet.
      allow read: if isSignedIn() && (id == uid() || isAdmin());
      // An artisan opens/updates their own request (e.g. adds documents or
      // resubmits after a rejection) but can only ever set it to pending;
      // approving or rejecting is the admin's call.
      allow create: if isArtisan() && id == uid() && incoming().artisanId == uid()
                    && incoming().status == 'pending';
      allow update: if isAdmin()
                    || (isArtisan() && id == uid() && existing().artisanId == uid()
                        && incoming().artisanId == uid() && incoming().status == 'pending');
      allow delete: if isAdmin();

      // The document photos (ID, selfie, certificates) as compressed image
      // data URLs, one per doc. Private to the artisan and admins.
      match /files/{fileId} {
        allow read: if isSignedIn() && (id == uid() || isAdmin());
        allow create, update: if isArtisan() && id == uid()
                              && incoming().dataUrl is string
                              && incoming().dataUrl.size() <= 900000
                              && incoming().dataUrl[0:11] == 'data:image/';
        allow delete: if isAdmin() || (isArtisan() && id == uid());
      }
    }

    // ── supportThreads/{uid} ─────────────────────────────────────────────────
    // A user's chat with the Qareeb team (dashboard → Support), one thread per
    // account; a suspended account can still use it. Messages are plain text:
    // they are for the team to read. The header (who, last message, unread
    // marks) is kept up to date by whoever writes.
    match /supportThreads/{userId} {
      function owner() {
        return isAuthed() && uid() == userId;
      }
      allow read: if owner() || isAdmin();
      allow create: if owner() && incoming().uid == userId && incoming().lastFrom == 'user';
      allow update: if isAdmin()
                    || (owner() && incoming().uid == userId
                        && incoming().diff(existing()).affectedKeys()
                             .hasOnly(['name', 'role', 'phone', 'lastMessage', 'lastAt', 'lastFrom', 'unreadForAdmin', 'unreadForUser', 'updatedAt'])
                        && (incoming().get('lastFrom', '') == existing().get('lastFrom', '') || incoming().lastFrom == 'user'));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if owner() || isAdmin();
        allow create: if isValidString(incoming().text, 1000)
                      && incoming().createdAt is number
                      && incoming().senderId == uid()
                      && ((owner() && incoming().from == 'user') || (isAdmin() && incoming().from == 'admin'));
        allow delete: if isAdmin();
      }
    }

    // ── auditLogs / cms (admin only) ─────────────────────────────────────────
    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }
    match /cms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
