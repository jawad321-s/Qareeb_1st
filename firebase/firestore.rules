rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Qareeb — Cloud Firestore Security Rules
// Model: customers own their requests; artisans read pending requests & manage
// their own offers; admins (custom claim) have full read + moderated writes.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }
    // Customer/artisan roles live on users/{uid}.role, written once at sign-up
    // and locked by the users update rule below, so no Cloud Function is needed
    // to issue claims. Admins still use the `role` custom claim (set-role script).
    function userDoc() {
      return /databases/$(database)/documents/users/$(uid());
    }
    function isArtisan() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'artisan'
        || (exists(userDoc()) && get(userDoc()).data.role == 'artisan'));
    }
    function existing() {
      return resource.data;
    }
    function incoming() {
      return request.resource.data;
    }
    // Field-level guards used on writes.
    function isValidString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // ── users/{uid} ──────────────────────────────────────────────────────────
    match /users/{userId} {
      // A user reads their own doc; admins read all. Artisans are public
      // service providers, so any signed-in user can read an artisan's doc
      // (listings, profiles, chat headers). Artisans can read customer docs to
      // show who they are chatting with / reviewing.
      // TODO: split public fields into a separate collection so phone/email
      // aren't exposed beyond the parties of an accepted job.
      allow read: if isSignedIn() && (
                    uid() == userId
                    || isAdmin()
                    || resource.data.role == 'artisan'
                    || isArtisan());
      allow create: if isSignedIn() && uid() == userId
                    && incoming().role in ['customer', 'artisan'];
      allow update: if isSignedIn() && (
                      (uid() == userId
                        // A user can never escalate their own role/verified/status.
                        && incoming().role == existing().role
                        && incoming().status == existing().status
                        && incoming().verified == existing().verified)
                      || isAdmin());
      allow delete: if isAdmin();

      match /notifications/{notifId} {
        allow read, update: if isSignedIn() && uid() == userId;
        allow create: if isAdmin(); // written by Cloud Functions (admin SDK)
        allow delete: if isSignedIn() && uid() == userId;
      }
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }
    }

    // ── artisanProfiles/{uid} ────────────────────────────────────────────────
    match /artisanProfiles/{artisanId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
                              (uid() == artisanId
                                // verificationStatus & premium are admin-controlled.
                                && incoming().verificationStatus == (resource == null ? 'unsubmitted' : existing().verificationStatus)
                                && incoming().premium == (resource == null ? false : existing().premium))
                              || isAdmin());
      allow delete: if isAdmin();
    }

    // ── categories / services (read-only to clients) ─────────────────────────
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── requests/{id} ────────────────────────────────────────────────────────
    match /requests/{requestId} {
      // Owner and admins always read. Artisans can read PENDING requests (to make
      // offers) and any request they have been accepted for.
      allow read: if isSignedIn() && (
                    existing().customerId == uid()
                    || isAdmin()
                    || (isArtisan() && (existing().status == 'PENDING'
                          || existing().acceptedArtisanId == uid())));
      // Dispatch state (radius, who was notified) is owned by Cloud Functions.
      function dispatchUntouched() {
        return !incoming().diff(existing()).affectedKeys().hasAny(['dispatch', 'notifiedArtisanIds']);
      }
      allow create: if isSignedIn()
                    && incoming().customerId == uid()
                    && incoming().status == 'PENDING'
                    && incoming().offerCount == 0
                    && !incoming().keys().hasAny(['dispatch', 'notifiedArtisanIds'])
                    && isValidString(incoming().title, 120)
                    && isValidString(incoming().description, 2000);
      allow update: if isAdmin() || (isSignedIn() && dispatchUntouched() && (
                      existing().customerId == uid()   // cancel / accept an offer
                      || (isArtisan() && existing().acceptedArtisanId == uid()) // status progression
                      // Any artisan bumps the counter by one when sending an offer.
                      || (isArtisan() && existing().status == 'PENDING'
                          && incoming().diff(existing()).affectedKeys().hasOnly(['offerCount', 'updatedAt'])
                          && incoming().offerCount == existing().offerCount + 1)));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // Only the two parties on an accepted request can read/write the thread.
        function req() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        allow read: if isSignedIn() && (req().customerId == uid() || req().acceptedArtisanId == uid() || isAdmin());
        // The thread closes once the job is completed or cancelled.
        allow create: if isSignedIn()
                      && incoming().senderId == uid()
                      && (req().customerId == uid() || req().acceptedArtisanId == uid())
                      && req().status in ['ACCEPTED', 'ON_THE_WAY', 'WORKING'];
        allow update: if isSignedIn() && (req().customerId == uid() || req().acceptedArtisanId == uid());
      }
    }

    // ── offers/{id} ──────────────────────────────────────────────────────────
    match /offers/{offerId} {
      allow read: if isSignedIn() && (
                    existing().artisanId == uid()
                    || existing().customerId == uid()
                    || isAdmin());
      // Only artisans the request was dispatched to (see Cloud Functions) can
      // quote on it, and only while it is still open.
      function dispatchedTo(requestId) {
        let req = get(/databases/$(database)/documents/requests/$(requestId)).data;
        return req.status == 'PENDING' && uid() in req.get('notifiedArtisanIds', []);
      }
      allow create: if isArtisan()
                    && incoming().artisanId == uid()
                    && incoming().status == 'PENDING'
                    && incoming().price is number && incoming().price > 0
                    && dispatchedTo(incoming().requestId);
      // Artisan may withdraw; customer may accept/reject (status transitions only).
      allow update: if isSignedIn() && (
                      (existing().artisanId == uid() && incoming().status == 'WITHDRAWN')
                      || existing().customerId == uid()
                      || isAdmin());
      allow delete: if isAdmin();
    }

    // ── reviews/{id} ─────────────────────────────────────────────────────────
    match /reviews/{id} {
      allow read: if true;
      // Rating is mandatory for both sides once a job is COMPLETED. Only a
      // party to that request may write, only about the other party, and the
      // id is `${requestId}_${authorId}` so each person rates a job once —
      // there is no `update`, so a second write for the same pair is denied.
      allow create: if isSignedIn()
                    && incoming().authorId == uid()
                    && id == incoming().requestId + '_' + uid()
                    && incoming().rating is int
                    && incoming().rating >= 1 && incoming().rating <= 5
                    && reviewableBy(incoming().requestId, incoming().targetId);
      allow update, delete: if isAdmin();
    }
    function reviewableBy(requestId, targetId) {
      let req = get(/databases/$(database)/documents/requests/$(requestId)).data;
      return req.status == 'COMPLETED'
        && ((req.customerId == uid() && req.acceptedArtisanId == targetId)
         || (req.acceptedArtisanId == uid() && req.customerId == targetId));
    }

    // ── subscriptions ────────────────────────────────────────────────────────
    match /subscriptions/{id} {
      allow read: if isSignedIn() && (existing().artisanId == uid() || isAdmin());
      allow create: if isArtisan() && incoming().artisanId == uid();
      // The artisan may cancel their own plan (ends it at once, no refund) —
      // and change nothing else on it.
      allow update: if isAdmin()
                    || (isArtisan() && existing().artisanId == uid()
                        && incoming().status == 'cancelled'
                        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isAdmin();
    }

    // ── complaints ───────────────────────────────────────────────────────────
    match /complaints/{id} {
      allow read: if isSignedIn() && (existing().reporterId == uid() || isAdmin());
      allow create: if isSignedIn() && incoming().reporterId == uid();
      allow update, delete: if isAdmin();
    }

    // ── verificationRequests ─────────────────────────────────────────────────
    match /verificationRequests/{id} {
      allow read: if isSignedIn() && (existing().artisanId == uid() || isAdmin());
      allow create: if isArtisan() && incoming().artisanId == uid();
      allow update, delete: if isAdmin();
    }

    // ── auditLogs / cms (admin only) ─────────────────────────────────────────
    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }
    match /cms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
