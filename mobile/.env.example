# Firebase. Optional: leave empty to use the team's project (qareeb-b9a54),
# built into src/lib/config.ts. Fill in only to point at another project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to "true" to run entirely on the bundled Mock API (no backend needed).
# Leave "false" to use Firebase.
EXPO_PUBLIC_USE_MOCK=false

# Only admin-verified artisans receive requests (approve them in the admin
# dashboard → Artisans). Set "false" to skip verification.
EXPO_PUBLIC_REQUIRE_VERIFIED=true

# Use the local Firebase emulators (firebase emulators:start) instead of the
# real project: the IP of the computer running them, e.g. 192.168.1.20
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
