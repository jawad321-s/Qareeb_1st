# Firebase (from your Firebase project settings → Web app config)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to "true" to run entirely on the bundled Mock API (no backend needed).
# Leave "false" to use the Firebase project above (mock is also used
# automatically while the Firebase values are empty).
EXPO_PUBLIC_USE_MOCK=false

# Only admin-verified artisans receive requests. Leave "false" while testing;
# set "true" before launch (also REQUIRE_VERIFIED in firebase/functions/src/config.js).
EXPO_PUBLIC_REQUIRE_VERIFIED=false
