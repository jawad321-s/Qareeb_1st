{
  "expo": {
    "name": "Qareeb",
    "slug": "qareeb",
    "owner": "project-2026-2027",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qareeb",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#031746"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qareeb.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Qareeb uses your location to match you with nearby artisans.",
        "NSCameraUsageDescription": "Qareeb uses the camera to take photos for your requests and your chats.",
        "NSPhotoLibraryUsageDescription": "Qareeb uses your photos to attach them to your requests and your chats."
      }
    },
    "android": {
      "package": "com.qareeb.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#031746"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031746",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-localization",
        {
          "forcesRTL": true,
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76ba06a5-0a3a-4c8e-9b72-00ae3a9b6e05"
      },
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
