{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // No `baseUrl`: TypeScript 6 deprecates it, and path mappings that start
    // with "./" already resolve relative to this file.
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
